  "programs": {
   "p2": {
    "lang": "sketch",
    "source": "// Blink: the LED on pin 13 is on for half a second, off for half a second.\nconst int LED = 13;\n\nvoid setup() {\n  pinMode(LED, OUTPUT);\n}\n\nvoid loop() {\n  digitalWrite(LED, HIGH);\n  delay(500);\n  digitalWrite(LED, LOW);\n  delay(500);\n}\n"
   }

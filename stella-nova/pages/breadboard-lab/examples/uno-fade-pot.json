  "programs": {
   "p2": {
    "lang": "sketch",
    "source": "// The pot sets the LED brightness. Open the plotter to see the reading.\nconst int POT = A0;\nconst int LED = 9;\n\nvoid setup() {\n  pinMode(LED, OUTPUT);\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  int raw = analogRead(POT);          // 0..1023\n  int duty = map(raw, 0, 1023, 0, 255);\n  analogWrite(LED, duty);\n  Serial.print(\"pot:\");\n  Serial.print(raw);\n  Serial.print(\",duty:\");\n  Serial.println(duty);\n  delay(50);\n}\n"
   }
  },
  "sim": {
   "speed": 1,
   "pwm": "auto"
  },

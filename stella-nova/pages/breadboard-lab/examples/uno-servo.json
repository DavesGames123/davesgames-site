  "programs": {
   "p2": {
    "lang": "sketch",
    "source": "// The pot sets the servo horn angle.\n#include <Servo.h>\n\nServo horn;\n\nvoid setup() {\n  horn.attach(9);\n}\n\nvoid loop() {\n  int raw = analogRead(A0);\n  int angle = map(raw, 0, 1023, 0, 180);\n  horn.write(angle);\n  delay(20);\n}\n"
   }

// Rosette in time - an animated design for the davesgames.io Context Free
// page. GPL-2.0-or-later, like the engine. Each frame runs the grammar
// again with a new ftime(), so the arms curl and the colour turns. The
// nine arms are 40 degrees apart, so the turn of 40 degrees loops.
startshape ROSETTE [r (ftime() * 40)]
CF::Time = [time 0 1]
CF::Background = [b -0.92]

shape ROSETTE {
  loop 9 [r 40]
    ARM [h (250 + 70 * sin(ftime() * 360)) sat 0.75 b 1 a -0.35]
}

shape ARM
rule {
  CIRCLE [s 0.6]
  ARM [y 0.5 s 0.94 r (5 + 9 * sin(ftime() * 360)) h 3]
}
rule 0.05 {
  ARM [flip 90]
}

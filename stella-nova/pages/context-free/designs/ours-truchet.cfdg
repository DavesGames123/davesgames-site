// Truchet weave - a tiled design for the davesgames.io Context Free page.
// GPL-2.0-or-later, like the engine. Each cell picks one of two quarter
// arc tiles; CF::Tile makes the 12 x 12 block repeat with no seam.
startshape WEAVE
CF::Tile = [s 12]
CF::Background = [b -0.95]

shape WEAVE {
  loop 12 [x 1]
    loop 12 [y 1]
      CELL [h (rand(170, 250)) sat 0.7 b 0.95]
}

shape CELL
rule { ARCS [] }
rule { ARCS [r 90] }

path ARCS {
  MOVETO(0, -0.5)
  ARCTO(-0.5, 0, 0.5)
  MOVETO(0, 0.5)
  ARCTO(0.5, 0, 0.5)
  STROKE(0.34) [a -0.85]
  STROKE(0.12) []
}

     double area = s.area();
     if (!s.mWorldState.isFinite()) {
         requestStop = true;
@@ -1010,6 +1023,8 @@ RendererImpl::drawShape(const FinishedShape& s)
 
     if (!s.mWorldState.m_time.overlaps(mFrameTimeBounds))
         return;
+    if (!CFDG_WEB_KEEP(s))
+        return;
 
     m_stats.outputDone += 1;
 

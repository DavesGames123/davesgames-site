+// Modified 2026-10-06 by davesgames.io (patch 0004-grow-replay): with
+// CFDG_WEB defined, processShape() counts the generation of each new
+// shape in m_Depth, and drawShape() asks cfdgWebKeep() whether to draw
+// a finished shape. The web page uses this to replay the growth of a
+// design, a subset of the finished shapes at a time.
+//
 
 
 #include "renderimpl.h"
@@ -36,8 +42,12 @@
 #ifdef CFDG_WEB
 extern "C" int cfdgWebTick(void);
 #define CFDG_WEB_TICK() (cfdgWebTick() != 0)
+class FinishedShape;
+bool cfdgWebKeep(const FinishedShape& s);
+#define CFDG_WEB_KEEP(s) cfdgWebKeep(s)
 #else
 #define CFDG_WEB_TICK() false
+#define CFDG_WEB_KEEP(s) true
 #endif
 
 #include <iterator>
@@ -593,6 +603,9 @@ RendererImpl::animate(Canvas* canvas, int frames, int frame, bool zoom)
 void
 RendererImpl::processShape(Shape& s)
 {
+#ifdef CFDG_WEB
+    s.mWorldState.m_Depth += 1;     // a child starts with the depth of its parent

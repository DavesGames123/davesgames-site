fn F_collatz(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var xV: vec4f = vec4f(1.0, 1.0, 1.0, 0.0);
	var temp: vec4f = (xV + (z * 2.0));
	temp *= RotateAroundVectorByAngle4(z, xV.xyz, 3.14159274101257);
	z = ((xV + (z * 4.0)) - temp);
	z /= 4.0;
	(*aux).DE = (((*aux).DE * 4.0) + 1.0);
	return z;
}

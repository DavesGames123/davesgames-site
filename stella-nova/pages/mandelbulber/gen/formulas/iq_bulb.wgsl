fn F_iq_bulb(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var wr: f32 = (*aux).r;
	var wo: f32 = acos((z.y / wr));
	var wi: f32 = atan2(z.x, z.z);
	wr = c_pow_f32(wr, (FR[fi].transformCommon.pwr8 - 1.0));
	(*aux).DE = (((wr * (*aux).DE) * FR[fi].transformCommon.pwr8) + 1.0);
	wr *= (*aux).r;
	wo *= FR[fi].transformCommon.pwr8;
	wi *= FR[fi].transformCommon.pwr8a;
	z.x = (sin(wo) * sin(wi));
	z.y = cos(wo);
	z.z = (sin(wo) * cos(wi));
	z *= wr;
	return z;
}

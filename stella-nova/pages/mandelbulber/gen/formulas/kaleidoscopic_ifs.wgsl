		}
	}
	if ((FR[fi].IFS.rotationEnabled != 0)) {
		z = (Matrix33MulFloat4(FR[fi].IFS.mainRot, (z - FR[fi].IFS.offset)) + FR[fi].IFS.offset);
	}
	if ((FR[fi].IFS.edgeEnabled != 0)) {
		if ((FR[fi].IFS.edge.x > 0.0)) {
			z.x = (FR[fi].IFS.edge.x - abs((FR[fi].IFS.edge.x - z.x)));

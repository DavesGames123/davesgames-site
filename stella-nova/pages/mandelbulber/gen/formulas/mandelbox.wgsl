// grep: F_mandelbox

fn F_mandelbox(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	if ((FR[fi].mandelbox.rotationsEnabled != 0)) {
		var zRot: vec4f;
		for (var dim: i32 = 0; (dim < 3); dim++) {
			let rotDim_i: i32 = select(select(2, 1, (dim == 1)), 0, (dim == 0));
			let colorFactor_i: i32 = select(select(2, 1, (dim == 1)), 0, (dim == 0));
			zRot = Matrix33MulFloat4(FR[fi].mandelbox.rot[0][dim], z);
			if ((zRot[rotDim_i] > FR[fi].mandelbox.foldingLimit)) {
				zRot[rotDim_i] = (FR[fi].mandelbox.foldingValue - zRot[rotDim_i]);
				z = Matrix33MulFloat4(FR[fi].mandelbox.rotinv[0][dim], zRot);
				(*aux).color += FR[fi].mandelbox.color.factor[colorFactor_i];
			} else {
				zRot = Matrix33MulFloat4(FR[fi].mandelbox.rot[1][dim], z);
				if ((zRot[rotDim_i] < -(FR[fi].mandelbox.foldingLimit))) {
					zRot[rotDim_i] = (-(FR[fi].mandelbox.foldingValue) - zRot[rotDim_i]);
					z = Matrix33MulFloat4(FR[fi].mandelbox.rotinv[1][dim], zRot);
					(*aux).color += FR[fi].mandelbox.color.factor[colorFactor_i];
				}
			}
		}
	} else {
		if ((abs(z.x) > FR[fi].mandelbox.foldingLimit)) {
			z.x = ((sign(z.x) * FR[fi].mandelbox.foldingValue) - z.x);
			(*aux).color += FR[fi].mandelbox.color.factor.x;
		}
		if ((abs(z.y) > FR[fi].mandelbox.foldingLimit)) {
			z.y = ((sign(z.y) * FR[fi].mandelbox.foldingValue) - z.y);
			(*aux).color += FR[fi].mandelbox.color.factor.y;
		}
		if ((abs(z.z) > FR[fi].mandelbox.foldingLimit)) {
			z.z = ((sign(z.z) * FR[fi].mandelbox.foldingValue) - z.z);
			(*aux).color += FR[fi].mandelbox.color.factor.z;
		}
	}
	var r2: f32 = dot(z, z);
	z += FR[fi].mandelbox.offset;
	if ((r2 < FR[fi].mandelbox.mR2)) {
		z *= FR[fi].mandelbox.mboxFactor1;
		(*aux).DE *= FR[fi].mandelbox.mboxFactor1;
		(*aux).color += FR[fi].mandelbox.color.factorSp1;
	} else if ((r2 < FR[fi].mandelbox.fR2)) {
		var tglad_factor2: f32 = (FR[fi].mandelbox.fR2 / r2);
		z *= tglad_factor2;
		(*aux).DE *= tglad_factor2;
		(*aux).color += FR[fi].mandelbox.color.factorSp2;
	}
	z -= FR[fi].mandelbox.offset;
	if ((FR[fi].mandelbox.mainRotationEnabled != 0)) {
		z = Matrix33MulFloat4(FR[fi].mandelbox.mainRot, z);
	}
	z = (z * FR[fi].mandelbox.scale);
	(*aux).DE = (((*aux).DE * abs(FR[fi].mandelbox.scale)) + 1.0);
	return z;
}

fn F_mandelbox_fast(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var ones: vec4f = vec4f(1.0, 1.0, 1.0, 1.0);
	z = ((abs((z + ones)) - abs((z - ones))) - z);
	var r2: f32 = dot(z, z);

fn F_mandelbulb_power2(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	(*aux).DE = (((*aux).DE * 2.0) * (*aux).r);
	var x2: f32 = (z.x * z.x);
	var y2: f32 = (z.y * z.y);
	var z2: f32 = (z.z * z.z);
	var temp: f32 = (1.0 - (z2 / (x2 + y2)));
	var newx: f32 = ((x2 - y2) * temp);
	var newy: f32 = (((2.0 * z.x) * z.y) * temp);
	var newz: f32 = ((-2.0 * z.z) * sqrt((x2 + y2)));
	z.x = newx;
	z.y = newy;
	z.z = newz;
	return z;
}

//
// grep: F_transf_add_constant

fn F_transf_add_constant(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	z += FR[fi].transformCommon.additionConstant000;
	z += FR[fi].transformCommon.additionConstantA000;
	return z;
}

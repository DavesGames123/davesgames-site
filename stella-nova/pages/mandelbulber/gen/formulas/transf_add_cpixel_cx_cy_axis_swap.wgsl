//   Adds Cpixel constant to z vector, swapping the Cpixel vector x and y axes
//   disable swap for normal mode
//
// grep: F_transf_add_cpixel_cx_cy_axis_swap

fn F_transf_add_cpixel_cx_cy_axis_swap(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var c: vec4f = (*aux).const_c;
	var tempC: vec4f = c;
	if ((FR[fi].transformCommon.functionEnabled != 0)) {
		if ((FR[fi].transformCommon.alternateEnabledFalse != 0)) {
			tempC = (*aux).c;
			tempC = vec4f(tempC.y, tempC.x, tempC.z, tempC.w);
			(*aux).c = tempC;
		} else {
			tempC = vec4f(c.y, c.x, c.z, c.w);
		}
	}
	z += (tempC * FR[fi].transformCommon.constantMultiplier111);
	return z;
}

//   Adds Cpixel constant to z vector, with symmetry
//
// grep: F_transf_add_cpixel_symmetrical

fn F_transf_add_cpixel_symmetrical(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var tempFAB: vec4f = (*aux).const_c;
	if ((FR[fi].transformCommon.functionEnabledx != 0)) {
		tempFAB.x = abs(tempFAB.x);
	}
	if ((FR[fi].transformCommon.functionEnabledy != 0)) {
		tempFAB.y = abs(tempFAB.y);
	}
	if ((FR[fi].transformCommon.functionEnabledz != 0)) {
		tempFAB.z = abs(tempFAB.z);
	}
	tempFAB *= FR[fi].transformCommon.constantMultiplier111;
	z.x += (sign(z.x) * tempFAB.x);
	z.y += (sign(z.y) * tempFAB.y);
	z.z += (sign(z.z) * tempFAB.z);
	return z;
}

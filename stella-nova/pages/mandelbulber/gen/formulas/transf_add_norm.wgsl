fn F_transf_add_norm(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	z += FR[fi].transformCommon.offset000;
	var zNorm: vec4f = (z / (*aux).r);
	var rotadd: vec4f = Matrix33MulFloat4(FR[fi].transformCommon.rotationMatrix, zNorm);
	z += (FR[fi].transformCommon.scale1 * rotadd);
	z -= FR[fi].transformCommon.offset000;
	if ((FR[fi].analyticDE.enabledFalse != 0)) {
		(*aux).DE = (((((*aux).DE * length(z)) / (*aux).r) * FR[fi].analyticDE.scale1) + FR[fi].analyticDE.offset0);
	}
	return z;
}

fn F_transf_add_scale_rotate(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	z += FR[fi].transformCommon.additionConstant000;
	z *= FR[fi].transformCommon.scale1;
	if (!((FR[fi].analyticDE.enabledFalse != 0))) {
		(*aux).DE *= abs(FR[fi].transformCommon.scale1);
	} else {
		(*aux).DE = ((((*aux).DE * abs(FR[fi].transformCommon.scale1)) * FR[fi].analyticDE.scale1) + FR[fi].analyticDE.offset1);
	}
	z = Matrix33MulFloat4(FR[fi].transformCommon.rotationMatrix, z);
	z += FR[fi].transformCommon.additionConstantA000;
	return z;
}

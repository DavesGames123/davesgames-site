fn F_transf_add_spherical_invert(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var t: vec4f = z;
	var d: f32 = (1.0 / dot(t, t));
	var r: f32 = (1.0 / (*aux).r);
	if (!((FR[fi].transformCommon.functionEnabledFalse != 0))) {
		d = (r + ((d - r) * FR[fi].transformCommon.scaleA1));
	} else {
		d = (d + ((r - d) * FR[fi].transformCommon.scaleA1));
	}
	var g: vec4f = FR[fi].transformCommon.scale3D111;
	t *= (g * d);
	(*aux).DE += (1.0 / (*aux).DE);
	z = ((z + t) * FR[fi].transformCommon.scaleB1);
	(*aux).DE *= abs(FR[fi].transformCommon.scaleB1);
	if ((FR[fi].analyticDE.enabledFalse != 0)) {
		(*aux).DE = (((*aux).DE * FR[fi].analyticDE.scale1) + FR[fi].analyticDE.offset0);
	}
	return z;
}

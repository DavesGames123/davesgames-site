fn F_transf_box_offset(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var temp: vec4f = z;
	z.x = ((sign(z.x) * FR[fi].transformCommon.additionConstant000.x) + z.x);
	z.y = ((sign(z.y) * FR[fi].transformCommon.additionConstant000.y) + z.y);
	z.z = ((sign(z.z) * FR[fi].transformCommon.additionConstant000.z) + z.z);
	if ((FR[fi].transformCommon.functionEnabledFalse != 0)) {
		var tempL: f32 = length(temp);
		var avgScale: f32 = (length(z) / tempL);
		(*aux).DE = (((*aux).DE * avgScale) + 1.0);
	}
	return z;
}

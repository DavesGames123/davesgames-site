fn F_transf_iteration_weight(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var zA: vec4f = select(vec4f(0.0, 0.0, 0.0, 0.0), z, ((*aux).i == FR[fi].transformCommon.intA));
	var zB: vec4f = select(vec4f(0.0, 0.0, 0.0, 0.0), z, ((*aux).i == FR[fi].transformCommon.intB));
	z = (((z * FR[fi].transformCommon.scale) + (zA * FR[fi].transformCommon.offset)) + (zB * FR[fi].transformCommon.offset0));
	(*aux).DE *= FR[fi].transformCommon.scale;
	return z;
}

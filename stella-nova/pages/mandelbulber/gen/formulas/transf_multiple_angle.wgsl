fn F_transf_multiple_angle(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var th0: f32 = asin((z.z / (*aux).r));
	var ph0: f32 = atan2(z.y, z.x);
	var th: f32 = (th0 * FR[fi].transformCommon.multiplication);
	var ph: f32 = (ph0 * FR[fi].transformCommon.multiplication);
	var cth: f32 = cos(th);
	z = (vec4f((cth * cos(ph)), (cth * sin(ph)), sin(th), 0.0) * (*aux).r);
	return z;
}

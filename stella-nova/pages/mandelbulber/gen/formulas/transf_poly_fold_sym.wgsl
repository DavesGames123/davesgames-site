fn F_transf_poly_fold_sym(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var oldZ: vec4f = z;
	var order: i32 = FR[fi].transformCommon.int6;
	var div2PI: f32 = (f32(order) / 6.283185307179586476925286766559);
	var cy: bool = false;
	var sector: i32 = i32((-div2PI * atan((z.x / z.y))));
	if (((sector & 1) != 0)) {
		cy = true;
	}
	var angle: f32 = (f32(sector) / div2PI);
	var tempZx: f32 = z.x;
	z.x = fma(z.x, cos(angle), (-z.y * sin(angle)));
	z.y = fma(tempZx, sin(angle), (z.y * cos(angle)));
	if (cy) {
		z.y = -z.y;
	}
	if ((FR[fi].analyticDE.enabled != 0)) {
		if (!((FR[fi].analyticDE.enabledFalse != 0))) {
			(*aux).DE = fma((*aux).DE, FR[fi].analyticDE.scale1, FR[fi].analyticDE.offset0);
		} else {
			var avgScale: f32 = (length(z) / length(oldZ));
			(*aux).DE = fma(((*aux).DE * avgScale), FR[fi].analyticDE.scale1, FR[fi].analyticDE.offset0);
		}
	}
	return z;
}

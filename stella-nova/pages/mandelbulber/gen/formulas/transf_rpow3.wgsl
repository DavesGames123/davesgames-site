fn F_transf_rpow3(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var sqrRout: f32 = (dot(z, z) * FR[fi].transformCommon.scale);
	z *= sqrRout;
	(*aux).DE = (((*aux).DE * abs(sqrRout)) + FR[fi].analyticDE.offset1);
	return z;
}

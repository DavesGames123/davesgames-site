fn F_transf_spherical_coord_invs(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var t: vec4f = z;
	var sn: f32 = 0.0;
	if ((FR[fi].transformCommon.functionEnabled != 0)) {
		sn = (z.x * sin(z.y));
		t.x = (sn * cos(z.z));
		t.y = (sn * sin(z.z));
		t.z = (z.x * cos(z.y));
	}
	if ((FR[fi].transformCommon.functionEnabledAFalse != 0)) {
		sn = (z.z * sin(z.x));
		t.x = (sn * sin(z.y));
		t.y = (z.z * cos(z.x));
		t.z = (sn * cos(z.y));
	}
	if ((FR[fi].transformCommon.functionEnabledBFalse != 0)) {
		sn = (z.y * sin(z.x));
		t.x = (sn * sin(z.z));
		t.y = (sn * cos(z.z));
		t.z = (z.y * cos(z.x));
	}
	z = (t + FR[fi].transformCommon.offset000);
	return z;
}

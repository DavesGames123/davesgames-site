fn F_transf_spherical_fold_abox(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	var r2: f32 = dot(z, z);
	z += FR[fi].mandelbox.offset;
	var sqrtMinR: f32 = FR[fi].transformCommon.sqtR;
	if ((r2 < sqrtMinR)) {
		z *= FR[fi].transformCommon.mboxFactor1;
		(*aux).DE *= FR[fi].transformCommon.mboxFactor1;
		if ((FR[fi].foldColor.auxColorEnabledFalse != 0)) {
			(*aux).color += FR[fi].mandelbox.color.factorSp1;
		}
	} else if ((r2 < 1.0)) {
		z *= (1.0 / r2);
		(*aux).DE *= (1.0 / r2);
		if ((FR[fi].foldColor.auxColorEnabledFalse != 0)) {
			(*aux).color += FR[fi].mandelbox.color.factorSp2;
		}
	}
	z -= FR[fi].mandelbox.offset;
	return z;
}

//   spherical radial offset.
//   This formula contains analytic aux.DE and aux.r-dz
//
// grep: F_transf_spherical_offset

fn F_transf_spherical_offset(z_in: vec4f, fi: u32, aux: ptr<function, Aux>) -> vec4f {
	var z: vec4f = z_in;
	z *= (1.0 + (FR[fi].transformCommon.offset / -(length(z))));
	z *= FR[fi].transformCommon.scale;
	(*aux).DE = (((*aux).DE * FR[fi].transformCommon.scale) + FR[fi].analyticDE.offset1);
	return z;
}

<!-- MuJoCo Lab model, written for this site (stella-nova/pages/mujoco-lab). -->
<!-- Restitution in MuJoCo: a negative solref sets the contact stiffness and
     damping directly (solref="-stiffness -damping"). With damping 0 the
     contact is elastic and the ball comes back to its drop height; more
     damping takes more energy out of each bounce. -->
<mujoco model="bouncing balls">
  <option timestep="0.0005" integrator="RK4"/>
  <visual><global azimuth="90" elevation="-10"/></visual>
  <default><geom type="sphere" size=".05" mass="0.1" condim="1"/></default>
  <worldbody>
    <light pos="0 -1 3" dir="0 .3 -1"/>
    <geom name="floor" type="plane" size="2 2 .1" rgba=".22 .25 .3 1" solref="-20000 -0" solimp=".99 .99 .001"/>
    <body name="elastic" pos="-.3 0 1"><freejoint/><geom solref="-20000 -0" solimp=".99 .99 .001" rgba=".95 .75 .2 1"/></body>
    <body name="lively" pos="0 0 1"><freejoint/><geom solref="-20000 -4" solimp=".99 .99 .001" rgba=".95 .45 .2 1"/></body>
    <body name="dead" pos=".3 0 1"><freejoint/><geom solref="-20000 -20" solimp=".99 .99 .001" rgba=".7 .25 .2 1"/></body>
  </worldbody>
</mujoco>

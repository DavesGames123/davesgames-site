<!-- MuJoCo Lab model, written for this site (stella-nova/pages/mujoco-lab). -->
<mujoco model="cartpole">
  <option timestep="0.002" integrator="RK4"/>
  <visual><global azimuth="90" elevation="-10"/></visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".18 .2 .24" rgb2=".24 .27 .31" width="64" height="64"/>
    <material name="grid" texture="grid" texrepeat="8 8" texuniform="true"/>
  </asset>
  <default><geom contype="0" conaffinity="0"/></default>
  <worldbody>
    <light pos="0 -1 3" dir="0 .3 -1"/>
    <geom name="floor" type="plane" size="4 4 .1" material="grid"/>
    <geom name="rail" type="capsule" fromto="-2 0 1 2 0 1" size=".015" rgba=".55 .58 .62 1"/>
    <body name="cart" pos="0 0 1">
      <joint name="slider" type="slide" axis="1 0 0" range="-1.8 1.8" damping="0.2"/>
      <geom name="cart" type="box" size=".16 .1 .06" mass="1" rgba=".85 .55 .2 1"/>
      <body name="pole">
        <joint name="hinge" type="hinge" axis="0 1 0" damping="0.002"/>
        <geom name="pole" type="capsule" fromto="0 0 0 0 0 .9" size=".03" mass=".2" rgba=".3 .6 .9 1"/>
      </body>
    </body>
  </worldbody>
  <actuator><motor name="push" joint="slider" gear="25" ctrlrange="-1 1"/></actuator>
  <sensor>
    <jointpos name="cart x" joint="slider"/>
    <jointpos name="pole angle" joint="hinge"/>
  </sensor>
  <keyframe><key name="near upright" qpos="0 0.05"/></keyframe>
</mujoco>

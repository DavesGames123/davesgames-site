<!-- MuJoCo Lab model, written for this site (stella-nova/pages/mujoco-lab). -->
<!-- Frictionless and undamped, with no contacts: the total energy is a
     conserved quantity, so this model checks the integrators. -->
<mujoco model="double pendulum">
  <option timestep="0.001" integrator="RK4"><flag contact="disable"/></option>
  <visual><global azimuth="90" elevation="-5"/></visual>
  <worldbody>
    <light pos="0 -2 3" dir="0 .5 -1"/>
    <geom name="floor" type="plane" size="3 3 .1" rgba=".2 .23 .27 1"/>
    <geom name="pivot" type="cylinder" pos="0 0 1.6" size=".03 .03" zaxis="0 1 0" rgba=".6 .6 .65 1"/>
    <body name="upper" pos="0 0 1.6" euler="0 80 0">
      <joint name="shoulder" type="hinge" axis="0 1 0"/>
      <geom name="upper" type="capsule" fromto="0 0 0 0 0 -.5" size=".025" mass="1" rgba=".9 .45 .2 1"/>
      <body name="lower" pos="0 0 -.5" euler="0 30 0">
        <joint name="elbow" type="hinge" axis="0 1 0"/>
        <geom name="lower" type="capsule" fromto="0 0 0 0 0 -.5" size=".025" mass="1" rgba=".25 .6 .9 1"/>
        <site name="tip" pos="0 0 -.5" size=".02"/>
      </body>
    </body>
  </worldbody>
  <sensor><framepos name="tip" objtype="site" objname="tip"/></sensor>
</mujoco>

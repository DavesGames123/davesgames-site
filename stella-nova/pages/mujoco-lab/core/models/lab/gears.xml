<!-- MuJoCo Lab model, written for this site (stella-nova/pages/mujoco-lab). -->
<!-- Gears as equality constraints: joint equalities hold q_b = -2 q_a and
     q_c = -q_b, so a motor on the first gear turns the whole train. The
     teeth are for the eye only; they do not collide. -->
<mujoco model="gear train">
  <option timestep="0.002"/>
  <visual><global azimuth="90" elevation="-10"/></visual>
  <default>
    <geom contype="0" conaffinity="0"/>
    <joint type="hinge" axis="0 1 0" damping="0.01"/>
    <default class="tooth"><geom type="box" size=".012 .02 .02"/></default>
  </default>
  <worldbody>
    <light pos="0 -1 3" dir="0 .3 -1"/>
    <geom name="floor" type="plane" size="2 2 .1" rgba=".22 .25 .3 1"/>
    <geom name="plate" type="box" pos="0 .06 .7" size=".75 .01 .45" rgba=".3 .33 .38 1"/>
    <body name="gear a" pos="-.45 0 .7">
      <joint name="a"/>
      <geom name="disc a" type="cylinder" size=".2 .02" zaxis="0 1 0" rgba=".85 .55 .2 1" mass="1"/>
      <replicate count="16" euler="0 22.5 0"><geom class="tooth" pos=".215 0 0" rgba=".85 .55 .2 1"/></replicate>
      <geom type="box" size=".18 .021 .015" rgba=".3 .2 .1 1"/>
    </body>
    <body name="gear b" pos="-.1 0 .7">
      <joint name="b"/>
      <geom name="disc b" type="cylinder" size=".1 .02" zaxis="0 1 0" rgba=".25 .6 .9 1" mass=".5"/>
      <replicate count="8" euler="0 45 0"><geom class="tooth" pos=".115 0 0" rgba=".25 .6 .9 1"/></replicate>
      <geom type="box" size=".08 .021 .015" rgba=".1 .2 .3 1"/>
    </body>
    <body name="gear c" pos=".1 0 .7">
      <joint name="c"/>
      <geom name="disc c" type="cylinder" size=".1 .02" zaxis="0 1 0" rgba=".5 .8 .4 1" mass=".5"/>
      <replicate count="8" euler="0 45 0"><geom class="tooth" pos=".115 0 0" rgba=".5 .8 .4 1"/></replicate>
      <geom type="box" size=".08 .021 .015" rgba=".15 .3 .1 1"/>
      <body name="crank" pos=".07 -.04 0">
        <joint name="pin"/>
        <geom name="rod" type="capsule" fromto="0 0 0 .4 0 0" size=".012" rgba=".8 .8 .85 1" mass=".1"/>
      </body>
    </body>
    <body name="slider" pos=".55 -.04 .7">
      <joint name="slide" type="slide" axis="1 0 0"/>
      <geom name="slider" type="box" size=".05 .03 .03" rgba=".9 .4 .3 1" mass=".2"/>
    </body>
  </worldbody>
  <equality>
    <joint joint1="b" joint2="a" polycoef="0 -2 0 0 0"/>
    <joint joint1="c" joint2="b" polycoef="0 -1 0 0 0"/>
    <connect body1="crank" body2="slider" anchor=".4 0 0"/>
  </equality>
  <actuator><velocity name="drive" joint="a" kv="5" ctrlrange="-3 3"/></actuator>
  <sensor>
    <jointpos name="a" joint="a"/>
    <jointpos name="b" joint="b"/>
    <jointpos name="slide" joint="slide"/>
  </sensor>
</mujoco>

<!-- MuJoCo Lab model, written for this site (stella-nova/pages/mujoco-lab). -->
<!-- After the tippe top of the MuJoCo Python tutorial (Apache-2.0,
     google-deepmind/mujoco python/tutorial.ipynb): a ball with a stem and a
     low centre of mass that turns over when it spins fast. -->
<mujoco model="tippe top">
  <option integrator="RK4" timestep="0.001"/>
  <visual><global azimuth="90" elevation="-20"/></visual>
  <worldbody>
    <light pos="0 0 1"/>
    <geom name="floor" type="plane" size="1 1 .01" rgba=".22 .25 .3 1"/>
    <body name="top" pos="0 0 .02">
      <freejoint/>
      <geom name="ball" type="sphere" size=".02" rgba=".85 .3 .25 1"/>
      <geom name="stem" type="cylinder" pos="0 0 .02" size=".004 .008" rgba=".9 .9 .85 1"/>
      <geom name="ballast" type="box" size=".023 .023 .005" pos="0 0 -.015" contype="0" conaffinity="0" group="3" rgba="0 0 0 0"/>
    </body>
  </worldbody>
  <keyframe><key name="spinning" qpos="0 0 0.02 1 0 0 0" qvel="0 0 0 0 1 200"/></keyframe>
</mujoco>
